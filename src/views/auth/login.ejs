<%- include('../partials/header', { title: 'Sign in' }) %>
<div class="login-shell">
  <div class="card login-card">
    <div class="brand"><i class="bi bi-calendar2-check"></i> LMS 2.0</div>
    <p class="muted">Leave Management System</p>

    <% if (authMode === 'entra') { %>
      <% if (entraError) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-octagon"></i> Could not reach Microsoft Entra ID: <%= entraError %></div>
      <% } %>
      <a class="microsoft-btn" href="/auth/login">
        <i class="bi bi-microsoft"></i> Sign in with Microsoft
      </a>
      <p class="muted" style="margin-top:16px;font-size:12px;">Authentication is delegated entirely to Microsoft Entra ID via OpenID Connect. There is no local password.</p>
    <% } else { %>
      <div class="alert alert-info" style="text-align:left;">
        <i class="bi bi-info-circle"></i>
        <span><strong>Development sign-in mode.</strong> This mirrors FRD requirement LMS-006 — a test auth mode that injects a fixed identity without contacting Entra, gated off in production. Pick a seeded user below.</span>
      </div>
      <% users.forEach(function(u) { %>
        <form method="POST" action="/auth/dev-login">
          <input type="hidden" name="user_id" value="<%= u.user_id %>">
          <button type="submit" class="btn dev-user-btn">
            <i class="bi bi-person-circle" style="font-size:20px;"></i>
            <span>
              <div style="font-weight:700;"><%= u.full_name %></div>
              <div class="muted" style="font-size:12px;"><%= u.email %></div>
            </span>
            <span class="badge badge-info role-chip"><%= u.isHrAdmin ? 'HR/Admin' : (u.isManager ? 'Manager' : 'Employee') %></span>
          </button>
        </form>
      <% }) %>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
