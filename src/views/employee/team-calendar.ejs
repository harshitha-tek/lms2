<%- include('../partials/header', { title: isManagerView ? 'Team Calendar' : 'Peer Calendar' }) %>
<%- include('../partials/sidebar', { title: isManagerView ? 'Team Calendar' : 'Peer Calendar' }) %>

<div class="card">
  <div class="card-header">
    <h2><i class="bi bi-calendar3"></i> <%= isManagerView ? 'Team coverage' : 'Peers on leave' %></h2>
    <span class="muted"><%= isManagerView ? 'Everyone beneath you in the hierarchy' : 'Employees sharing your manager' %></span>
  </div>
  <% if (!events.length) { %>
    <div class="empty-state"><i class="bi bi-calendar2-check"></i>No one is on approved leave right now.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Name</th><th>Dates</th><% if (isManagerView) { %><th>Type</th><% } %><th>Status</th></tr></thead>
      <tbody>
        <% events.forEach(function(e) { %>
          <tr>
            <td data-label="Name"><%= e.full_name %></td>
            <td data-label="Dates"><%= e.start_date %> → <%= e.end_date %></td>
            <% if (isManagerView) { %><td data-label="Type"><%= e.display_type %></td><% } %>
            <td data-label="Status"><span class="badge badge-<%= e.status === 'APPROVED' ? 'success' : 'warning' %>"><%= e.status.replace(/_/g,' ') %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
  <p class="muted" style="margin-top:14px;font-size:12px;">
    <% if (!isManagerView) { %>Per BR-41, leave type, reason and attachments are never shown on the peer calendar.<% } %>
  </p>
</div>

<%- include('../partials/footer') %>
