<%- include('../partials/header', { title: 'Holidays' }) %>
<%- include('../partials/sidebar', { title: 'Holidays' }) %>

<div class="card">
  <div class="card-header"><h2><i class="bi bi-flag"></i> Public holidays</h2><span class="muted">Current & next leave year</span></div>
  <% if (!holidays.length) { %>
    <div class="empty-state"><i class="bi bi-calendar-x"></i>No holidays published yet.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Date</th><th>Holiday</th></tr></thead>
      <tbody>
        <% holidays.forEach(function(h) { %>
          <tr><td data-label="Date"><%= h.holiday_date %></td><td data-label="Holiday"><%= h.holiday_name %></td></tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
