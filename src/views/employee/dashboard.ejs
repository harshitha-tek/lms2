<%- include('../partials/header', { title: 'Dashboard' }) %>
<%- include('../partials/sidebar', { title: 'Dashboard' }) %>

<% if (withdrawalBanner) { %>
  <div class="alert alert-danger">
    <i class="bi bi-exclamation-octagon"></i>
    <span>
      <strong><%= withdrawalBanner.request_number %></strong> was rejected as advance leave. Withdraw before the window closes or it converts to Loss of Pay.
      <a href="/leave/<%= withdrawalBanner.leave_request_id %>" style="text-decoration:underline;">View request →</a>
    </span>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <h2><i class="bi bi-wallet2"></i> Leave balances</h2>
    <a href="/leave/apply" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Apply for leave</a>
  </div>
  <div class="grid grid-4">
    <% balances.forEach(function(b) { %>
      <div>
        <div class="stat-label"><%= b.leaveType.leave_name %></div>
        <div class="stat-value"><%= b.effective.toFixed(1) %> <small>days available</small></div>
        <div class="muted" style="font-size:12px;margin-top:4px;">Ledger: <%= b.balance.toFixed(1) %> · Committed: <%= b.committed.toFixed(1) %></div>
      </div>
    <% }) %>
  </div>
</div>

<div class="grid grid-2">
  <div class="card">
    <div class="card-header"><h2><i class="bi bi-hourglass-split"></i> Pending requests</h2></div>
    <% if (!pending.length) { %>
      <div class="empty-state"><i class="bi bi-check2-circle"></i>Nothing pending right now.</div>
    <% } else { %>
      <% pending.forEach(function(r) { %>
        <div class="list-row">
          <div>
            <div style="font-weight:600;"><%= r.leave_name %> · <%= r.start_date %> → <%= r.end_date %></div>
            <div class="muted" style="font-size:12.5px;"><%= r.deducted_days %> day(s) · <%= r.request_number %></div>
          </div>
          <span class="badge badge-warning"><%= r.status.replace('_',' ') %></span>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><h2><i class="bi bi-calendar-check"></i> Upcoming approved leave</h2></div>
    <% if (!upcoming.length) { %>
      <div class="empty-state"><i class="bi bi-sun"></i>Nothing scheduled yet.</div>
    <% } else { %>
      <% upcoming.forEach(function(r) { %>
        <div class="list-row">
          <div>
            <div style="font-weight:600;"><%= r.leave_name %> · <%= r.start_date %> → <%= r.end_date %></div>
            <div class="muted" style="font-size:12.5px;"><%= r.deducted_days %> day(s)</div>
          </div>
          <span class="badge badge-success">Approved</span>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
