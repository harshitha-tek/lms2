<%- include('../partials/header', { title: 'My Requests' }) %>
<%- include('../partials/sidebar', { title: 'My Requests' }) %>

<%
function statusBadge(status) {
  const map = {
    DRAFT: 'neutral', PENDING_MANAGER: 'warning', PENDING_HR: 'warning', APPROVED: 'success',
    REJECTED: 'danger', REJECTED_PENDING_WITHDRAWAL: 'danger', WITHDRAWN: 'neutral',
    CANCELLATION_REQUESTED: 'warning', CANCELLED: 'neutral', LOP_APPLIED: 'danger',
  };
  return map[status] || 'neutral';
}
%>

<div class="card">
  <div class="card-header">
    <h2><i class="bi bi-list-check"></i> All requests</h2>
    <a href="/leave/apply" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> New request</a>
  </div>

  <% if (!requests.length) { %>
    <div class="empty-state"><i class="bi bi-inbox"></i>No requests yet — nothing to show.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Dates</th><th>Type</th><th>Days</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% requests.forEach(function(r) { %>
          <tr>
            <td data-label="Dates"><%= r.start_date %> → <%= r.end_date %></td>
            <td data-label="Type"><%= r.leave_name %></td>
            <td data-label="Days"><%= r.deducted_days %></td>
            <td data-label="Status"><span class="badge badge-<%= statusBadge(r.status) %>"><%= r.status.replace(/_/g,' ') %></span></td>
            <td data-label=""><a href="/leave/<%= r.leave_request_id %>" class="btn btn-sm btn-ghost">View <i class="bi bi-arrow-right"></i></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
