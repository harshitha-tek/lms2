<%- include('../partials/header', { title: 'Notifications' }) %>
<%- include('../partials/sidebar', { title: 'Notifications' }) %>

<div class="card">
  <div class="card-header"><h2><i class="bi bi-bell"></i> Notification centre</h2></div>
  <% if (!notifications.length) { %>
    <div class="empty-state"><i class="bi bi-bell-slash"></i>Nothing here yet.</div>
  <% } else { %>
    <% notifications.forEach(function(n) { %>
      <div class="list-row">
        <div>
          <div style="font-weight:<%= n.is_read ? '500' : '700' %>;"><%= n.subject %></div>
          <div class="muted" style="font-size:12.5px;"><%= n.body %></div>
          <div class="muted" style="font-size:11px;margin-top:2px;"><%= n.created_at %></div>
        </div>
        <% if (!n.is_read) { %>
          <form method="POST" action="/notifications/<%= n.notification_id %>/read"><button class="btn btn-sm">Mark read</button></form>
        <% } %>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
