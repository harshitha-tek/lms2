<%- include('../partials/header', { title: 'Audit Log' }) %>
<%- include('../partials/sidebar', { title: 'Audit Log' }) %>

<div class="card">
  <div class="card-header"><h2><i class="bi bi-shield-check"></i> Recent activity</h2><span class="muted">Immutable — append-only</span></div>
  <table>
    <thead><tr><th>When</th><th>Actor</th><th>Entity</th><th>Action</th></tr></thead>
    <tbody>
      <% entries.forEach(function(e) { %>
        <tr>
          <td data-label="When"><%= e.occurred_at %></td>
          <td data-label="Actor"><%= e.is_system_actor ? 'SYSTEM' : (e.actor_name || '—') %></td>
          <td data-label="Entity"><%= e.entity_type %> #<%= e.entity_id %></td>
          <td data-label="Action"><span class="chip"><%= e.action %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
