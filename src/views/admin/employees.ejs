<%- include('../partials/header', { title: 'Employees' }) %>
<%- include('../partials/sidebar', { title: 'Employees' }) %>

<div class="card">
  <div class="card-header"><h2><i class="bi bi-person-plus"></i> Add employee</h2></div>
  <form method="POST" action="/admin/employees">
    <div class="field-row">
      <div class="field"><label>Employee code</label><input name="employee_code" required></div>
      <div class="field"><label>Full name</label><input name="full_name" required></div>
      <div class="field"><label>Email</label><input type="email" name="email" required></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Department</label><select name="department_id"><% departments.forEach(function(d){ %><option value="<%= d.department_id %>"><%= d.department_name %></option><% }) %></select></div>
      <div class="field"><label>Grade</label><select name="grade_id"><% grades.forEach(function(g){ %><option value="<%= g.grade_id %>"><%= g.grade_name %></option><% }) %></select></div>
      <div class="field"><label>Management level</label><select name="management_level_id"><% managementLevels.forEach(function(m){ %><option value="<%= m.management_level_id %>"><%= m.level_name %></option><% }) %></select></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Reporting manager</label>
        <select name="manager_id"><option value="">— none —</option><% employees.forEach(function(e){ %><option value="<%= e.user_id %>"><%= e.full_name %></option><% }) %></select>
      </div>
      <div class="field"><label>Joined date</label><input type="date" name="joined_date" required></div>
    </div>
    <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Create employee</button>
  </form>
</div>

<div class="card">
  <div class="card-header"><h2><i class="bi bi-person-badge"></i> All employees</h2></div>
  <table>
    <thead><tr><th>Name</th><th>Code</th><th>Manager</th><th>Roles</th><th>Status</th></tr></thead>
    <tbody>
      <% employees.forEach(function(e) { %>
        <tr>
          <td data-label="Name"><%= e.full_name %></td>
          <td data-label="Code"><%= e.employee_code %></td>
          <td data-label="Manager"><%= e.manager_id ? (employees.find(x=>x.user_id===e.manager_id) || {}).full_name : '—' %></td>
          <td data-label="Roles"><% e.roles.forEach(function(r){ %><span class="chip" style="margin-right:4px;"><%= r %></span><% }) %></td>
          <td data-label="Status"><span class="badge badge-<%= e.is_active ? 'success' : 'neutral' %>"><%= e.is_active ? 'Active' : 'Inactive' %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
