<%- include('../partials/header', { title: 'Balance Adjustment' }) %>
<%- include('../partials/sidebar', { title: 'Balance Adjustment' }) %>

<div class="card">
  <div class="card-header"><h2><i class="bi bi-wallet2"></i> Manual adjustment</h2></div>
  <form method="POST" action="/admin/adjustments">
    <div class="field-row">
      <div class="field"><label>Employee</label>
        <select name="user_id" required>
          <% employees.forEach(function(e) { %><option value="<%= e.user_id %>" <%= selectedUser && selectedUser.user_id===e.user_id ? 'selected' : '' %>><%= e.full_name %></option><% }) %>
        </select>
      </div>
      <div class="field"><label>Leave type</label>
        <select name="leave_type_id" required><% leaveTypes.forEach(function(lt) { %><option value="<%= lt.leave_type_id %>"><%= lt.leave_name %></option><% }) %></select>
      </div>
      <div class="field"><label>Quantity (signed)</label><input type="number" step="0.5" name="quantity" placeholder="e.g. 2 or -1.5" required></div>
    </div>
    <div class="field"><label>Reason (mandatory)</label><input name="reason" required></div>
    <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Post adjustment</button>
  </form>
  <p class="muted" style="margin-top:10px;">Adjustments are written as a new ledger entry — never a silent edit — and the employee is notified.</p>
</div>

<% if (selectedUser) { %>
<div class="card">
  <div class="card-header"><h2><i class="bi bi-journal-text"></i> Full ledger — <%= selectedUser.full_name %></h2></div>
  <table>
    <thead><tr><th>Date</th><th>Type</th><th>Transaction</th><th>Quantity</th><th>Reference</th></tr></thead>
    <tbody>
      <% ledger.forEach(function(l) { %>
        <tr>
          <td data-label="Date"><%= l.created_at %></td>
          <td data-label="Type"><%= l.leave_name %></td>
          <td data-label="Transaction"><%= l.transaction_type %></td>
          <td data-label="Quantity"><%= l.quantity %></td>
          <td data-label="Reference"><%= l.source_reference || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="card"><p class="muted">Select an employee above, or <a href="#" onclick="return false;">jump to their ledger</a> from My Team.</p></div>
<% } %>

<%- include('../partials/footer') %>
