# =============================================================================
# LMS 2.0 — environment configuration
# Copy this file to .env and fill in real values before deploying.
# =============================================================================

PORT=3000
SESSION_SECRET=-------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Authentication mode
#   entra  -> real Microsoft Entra ID sign-in via OpenID Connect (production)
#   dev    -> local "pick a seeded user" sign-in, no Entra call at all.
#             Mirrors FRD requirement LMS-006: a dev/test auth mode that must
#             be OFF by default in any deployed environment. The app refuses
#             to start with AUTH_MODE=dev when NODE_ENV=production.
# ---------------------------------------------------------------------------
AUTH_MODE=dev

# Required only when AUTH_MODE=entra. Register an app in Entra ID / Azure AD,
# add a Web redirect URI of {APP_BASE_URL}/auth/callback, and fill these in.
APP_BASE_URL=http://localhost:3000
ENTRA_TENANT_ID=-----------------
ENTRA_CLIENT_ID=-----------------
ENTRA_CLIENT_SECRET=----------------

# Exchange Online is not wired to real SMTP in this reference build — every
# "sent" email is written to the in-app notification centre and logged to the
# console instead, per the pattern in src/services/notificationService.js.
